{
  "name": "fasal-slot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w packages/types && npm run build -w apps/web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "migrate": "npm run migrate -w apps/web",
    "seed": "npm run seed -w apps/web"
  }
}
