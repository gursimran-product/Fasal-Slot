# Local dev (docker compose): postgres://fasalslot:fasalslot@localhost:5432/fasalslot
# Supabase (production): use the "Connection pooling" URI from Project Settings > Database
DATABASE_URL=postgres://fasalslot:fasalslot@localhost:5432/fasalslot

JWT_ACCESS_SECRET=change-me-access

# Mixpanel project token (Project Settings > Access Keys on mixpanel.com).
# Same token for both — the project token is write-only and safe to expose client-side.
MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_TOKEN=
